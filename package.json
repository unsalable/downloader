{
  "name": "universal-downloader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fast, private and ad-free media downloading.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --split-per-abi --target aarch64 armv7 x86_64",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:python": "python -m unittest discover -s src-tauri/tests/python",
    "test:online": "cargo test --manifest-path src-tauri/Cargo.toml --test pipeline --test photos -- --ignored --test-threads=1 --nocapture",
    "test:all": "npm run build && npm run test:web && npm run test:rust && npm run test:python",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@remotion/player": "4.0.527",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.527",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "@remotion/tailwind-v4": "4.0.527",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
