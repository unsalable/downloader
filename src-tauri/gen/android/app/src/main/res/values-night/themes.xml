<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.universal_downloader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorAccent">@color/app_accent</item>
        <!-- The window opens in the phone's theme (app_background), dark
             here, so the bars' icons start light to match. The page then sets
             both to its own theme (BridgePlugin.setSystemBarsTheme). -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
