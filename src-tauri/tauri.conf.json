{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Downloader",
  "version": "1.0.0",
  "identifier": "io.universaldownloader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Downloader",
        "width": 1240,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "focus": true,
        "theme": "Dark",
        "backgroundColor": "#1C1C1E",
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Universal Downloader",
    "copyright": "Universal Downloader",
    "category": "Utility",
    "shortDescription": "Fast, private and ad-free media downloading.",
    "longDescription": "Paste a link from any supported platform and download the media at the best available quality. No ads, no tracking, no account.",
    "resources": {
      "resources/licenses.json": "resources/licenses.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Turkish"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
